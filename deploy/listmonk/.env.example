# Copy to .env (gitignored) alongside this file and fill in real values
# before bringing up deploy/listmonk/docker-compose.yml.

# Internal Postgres password for the vacaverse-mail-db container.
LISTMONK_DB_PASSWORD=

# Listmonk web dashboard login (Settings -> SMTP is configured here after boot).
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=
